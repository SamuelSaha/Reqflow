# ============================================================
# Swarm LangGraph — LLM Provider Configuration
# ============================================================
# This system is LLM-agnostic. Configure any provider below.
# Uses LiteLLM under the hood — supports 100+ providers.
# See: https://docs.litellm.ai/docs/providers
#
# Model string format: "provider/model-name"
# Examples:
#   anthropic/claude-sonnet-4-20250514
#   openai/gpt-4o
#   ollama/llama3.2
#   openrouter/meta-llama/llama-3.1-70b-instruct
#   together_ai/meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo
# ============================================================

# --- Provider API Keys (set the ones you use) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
GROQ_API_KEY=

# --- Ollama (local, no key needed) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Model Role Assignment ---
# Lead agent: best reasoning model (handles orchestration, compilation, delivery)
LEAD_MODEL=anthropic/claude-sonnet-4-20250514

# Domain agents: good reasoning for domain-specific tasks
DOMAIN_MODEL=openai/gpt-4o

# Subagents: cost-effective for focused single-task execution
SUBAGENT_MODEL=openai/gpt-4o-mini

# Verification: fast + cheap for binary pass/fail checks
VERIFICATION_MODEL=openai/gpt-4o-mini

# --- Temperature Settings ---
LEAD_TEMPERATURE=0.1
DOMAIN_TEMPERATURE=0.2
SUBAGENT_TEMPERATURE=0.3

# --- Checkpointer ---
# Options: sqlite, postgres
CHECKPOINTER_BACKEND=sqlite
CHECKPOINTER_URI=swarm_checkpoints.db
# For postgres: postgresql://user:pass@localhost:5432/swarm

# --- Project Path (auto-detected if not set) ---
# PROJECT_PATH=/path/to/your/project
