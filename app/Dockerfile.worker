# Dockerfile for BullMQ worker process
FROM node:20-alpine

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm ci --only=production

# Copy source code
COPY src ./src
COPY tsconfig.json ./

# Build TypeScript (if needed for worker)
# RUN npm run build:worker

# Run worker
CMD ["node", "--loader", "tsx", "src/lib/queue/worker.ts"]
