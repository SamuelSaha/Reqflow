#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🚀 Running pre-push security checks..."

# Run npm audit for the app (don't fail on vulnerabilities, just warn)
echo "Checking for vulnerable dependencies..."
npm audit --audit-level=high --omit=dev --workspace=app || audit_exit=$?
if [ "${audit_exit:-0}" -ne 0 ]; then
  echo "⚠️  Warning: Vulnerable dependencies found. Consider running npm audit fix."
fi

# Run type check
echo "Running TypeScript type check..."
npm run type-check --workspace=app
if [ $? -eq 1 ]; then
  echo "❌ TypeScript errors found. Fix before pushing."
  exit 1
fi

echo "✅ Pre-push checks passed"
