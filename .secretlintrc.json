{
  "$schema": "https://raw.githubusercontent.com/secretlint/secretlint/main/packages/%40secretlint/secretlint-rule-preset-recommend/secretlint-rule-preset-recommend.json",
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    },
    {
      "id": "@secretlint/secretlint-rule-npm",
      "options": {
        "allows": [
          "RESEND_API_KEY",
          "UPSTASH_REDIS_REST_URL",
          "UPSTASH_REDIS_REST_TOKEN"
        ]
      }
    },
    {
      "id": "@secretlint/secretlint-rule-slack",
      "options": {
        "allows": []
      }
    },
    {
      "id": "@secretlint/secretlint-rule-github",
      "options": {
        "allows": []
      }
    },
    {
      "id": "@secretlint/secretlint-rule-aws",
      "options": {
        "allows": []
      }
    },
    {
      "id": "@secretlint/secretlint-rule-google",
      "options": {}
    },
    {
      "id": "@secretlint/secretlint-rule-privatekey",
      "options": {}
    },
    {
      "id": "@secretlint/secretlint-rule-basicauth",
      "options": {}
    },
    {
      "id": "@secretlint/secretlint-rule-sendgrid"
    },
    {
      "id": "@secretlint/secretlint-rule-shopify"
    },
    {
      "id": "@secretlint/secretlint-rule-stripe"
    },
    {
      "id": "@secretlint/secretlint-rule-twitter"
    }
  ]
}
